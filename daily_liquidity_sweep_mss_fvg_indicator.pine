//@version=5
indicator(
     title            = "Daily Liquidity Sweep + MSS + FVG – Indicator",
     shorttitle       = "Liq-MSS-FVG",
     overlay          = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500
 )

// Model: previous-day High/Low liquidity sweep → market structure shift (MSS) → fair value gap (FVG) entry
//   1. Liq – price trades through the previous daily High (or Low).
//   2. MSS – a candle closes through the last swing low (high) that created the sweep leg.
//   3. FVG – the displacement leaves a fair value gap; entry on the retrace into it.
//   Stop beyond the sweep extreme; target at a fixed R:R or the opposite daily level.

// ─── INPUTS ───────────────────────────────────────────────────────────────────
htf          = input.timeframe("D", "Liquidity Timeframe",            group="Liquidity")
enableShort  = input.bool(true,  "Short signals (High sweep)",           group="Liquidity")
enableLong   = input.bool(true,  "Long signals (Low sweep)",          group="Liquidity")

pivotLen     = input.int(2,  "Swing Pivot Length (MSS)", minval=1,          group="Structure")
maxBarsMss   = input.int(36, "Max bars Sweep → MSS", minval=1,       group="Structure")

fvgMinAtr    = input.float(0.1, "Min FVG size (x ATR)", step=0.05, minval=0, group="FVG Entry")
entryMode    = input.string("FVG Edge", "Entry Price", options=["FVG Edge", "FVG Mid"], group="FVG Entry")
maxBarsFvg   = input.int(12, "Max bars MSS → FVG", minval=1,         group="FVG Entry")
maxBarsFill  = input.int(24, "Max bars to fill entry", minval=1,      group="FVG Entry")

atrLen       = input.int(14, "ATR Length",                                  group="Risk Management")
slBufAtr     = input.float(0.1, "SL buffer beyond sweep (x ATR)", step=0.05, minval=0, group="Risk Management")
tpMode       = input.string("Risk:Reward", "Take Profit", options=["Risk:Reward", "Opposite Daily Level"], group="Risk Management")
rr           = input.float(2.0, "Risk:Reward", step=0.1, minval=0.1, group="Risk Management")

useSession   = input.bool(false, "Only take sweeps inside session",                group="Session")
sessWindow   = input.session("0700-1700", "Session",                      group="Session")
sessTz       = input.string("GMT+0", "Session Timezone",                  group="Session")

showLevels   = input.bool(true, "Show previous High/Low",           group="Visuals")
showTable    = input.bool(true, "Show status table",                          group="Visuals")

// ─── HIGHER-TIMEFRAME LIQUIDITY (non-repainting previous High/Low) ────────────
[pdh, pdl] = request.security(syminfo.tickerid, htf, [high[1], low[1]], lookahead=barmerge.lookahead_on)
newPeriod  = ta.change(time(htf)) != 0

inSess = not useSession or not na(time(timeframe.period, sessWindow, sessTz))
atr    = ta.atr(atrLen)
minFvg = atr * fvgMinAtr

// ─── SWING POINTS (for MSS) ───────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastSwingHigh    = na
var int   lastSwingHighBar = na
var float lastSwingLow     = na
var int   lastSwingLowBar  = na
if not na(ph)
    lastSwingHigh    := ph
    lastSwingHighBar := bar_index - pivotLen
if not na(pl)
    lastSwingLow     := pl
    lastSwingLowBar  := bar_index - pivotLen

// ─── FVG DETECTION ────────────────────────────────────────────────────────────
bearFvg = low[2] > high and (low[2] - high) >= minFvg
bullFvg = high[2] < low and (low - high[2]) >= minFvg

// States: 0 = idle, 1 = swept (wait MSS), 2 = MSS (wait FVG), 3 = entry armed, 4 = in trade, 5 = done for the day
var bool inTrade = false

// One-bar event flags (for alerts)
sSweepEvt = false, sMssEvt = false, sArmEvt = false, sFillEvt = false, sTpEvt = false, sSlEvt = false
lSweepEvt = false, lMssEvt = false, lArmEvt = false, lFillEvt = false, lTpEvt = false, lSlEvt = false

// ─── SHORT SIDE STATE ─────────────────────────────────────────────────────────
var int   sState    = 0
var float sExtreme  = na
var int   sSweepBar = na
var float sMss      = na
var int   sMssPivot = na
var int   sMssBar   = na
var float sFvgTop   = na
var float sFvgBot   = na
var int   sFvgBar   = na
var float sEntry    = na
var float sSL       = na
var float sTP       = na
var int   sArmBar   = na
var label sLiqLbl   = na
var line  sEntryLn  = na
var line  sSlLn     = na
var line  sTpLn     = na

// ─── LONG SIDE STATE ──────────────────────────────────────────────────────────
var int   lState    = 0
var float lExtreme  = na
var int   lSweepBar = na
var float lMss      = na
var int   lMssPivot = na
var int   lMssBar   = na
var float lFvgTop   = na
var float lFvgBot   = na
var int   lFvgBar   = na
var float lEntry    = na
var float lSL       = na
var float lTP       = na
var int   lArmBar   = na
var label lLiqLbl   = na
var line  lEntryLn  = na
var line  lSlLn     = na
var line  lTpLn     = na

// ─── NEW PERIOD RESET (open trades keep running until SL/TP) ──────────────────
if newPeriod
    if sState != 4
        sState := 0
    if lState != 4
        lState := 0

// ═══ SHORT: sweep of previous High ═══════════════════════════════════════════
if enableShort and not na(pdh)
    if sState == 0 and high > pdh and inSess and not na(lastSwingLow) and lastSwingLow < pdh
        sState    := 1
        sSweepEvt := true
        sExtreme  := high
        sSweepBar := bar_index
        sMss      := lastSwingLow
        sMssPivot := lastSwingLowBar
        sFvgTop   := na
        sFvgBot   := na
        sLiqLbl   := label.new(bar_index, high, "Liq", style=label.style_label_down,
                          color=color.new(color.blue, 70), textcolor=color.white, size=size.small)
    else if sState == 1
        if high > sExtreme
            sExtreme := high
            label.set_xy(sLiqLbl, bar_index, high)
            if not na(lastSwingLow) and lastSwingLowBar > sMssPivot and lastSwingLow < close
                sMss      := lastSwingLow
                sMssPivot := lastSwingLowBar
        if close < sMss
            sState  := 2
            sMssEvt := true
            sMssBar := bar_index
            line.new(sMssPivot, sMss, bar_index, sMss, color=color.gray, style=line.style_dotted, width=2)
            label.new(math.round((sMssPivot + bar_index) / 2), sMss, "MSS", style=label.style_label_up,
                      color=color.new(color.gray, 100), textcolor=color.gray, size=size.small)
        else if bar_index - sSweepBar > maxBarsMss
            sState := 0

    if (sState == 1 or sState == 2) and bearFvg and bar_index - 2 >= sSweepBar
        sFvgTop := low[2]
        sFvgBot := high
        sFvgBar := bar_index - 2
    if not na(sFvgTop) and close > sFvgTop
        sFvgTop := na
        sFvgBot := na

    if sState == 2
        if not na(sFvgTop) and not inTrade
            sEntry := entryMode == "FVG Edge" ? sFvgBot : (sFvgTop + sFvgBot) / 2
            sSL    := sExtreme + atr * slBufAtr
            risk    = sSL - sEntry
            sTP    := tpMode == "Risk:Reward" ? sEntry - risk * rr : pdl
            if risk > 0 and sTP < sEntry
                box.new(sFvgBar, sFvgTop, bar_index + 10, sFvgBot, border_color=color.new(color.red, 40),
                        bgcolor=color.new(color.red, 85), text="FVG", text_color=color.gray, text_size=size.small)
                sEntryLn := line.new(bar_index, sEntry, bar_index + 1, sEntry, color=color.red,    width=2)
                sSlLn    := line.new(bar_index, sSL,    bar_index + 1, sSL,    color=color.orange, style=line.style_dashed)
                sTpLn    := line.new(bar_index, sTP,    bar_index + 1, sTP,    color=color.teal,   style=line.style_dashed)
                sState  := 3
                sArmEvt := true
                sArmBar := bar_index
            else
                sState := 5
        else if bar_index - sMssBar > maxBarsFvg
            sState := 0

    if sState == 3 and bar_index > sArmBar
        if high > sSL
            sState := 0
        else if high >= sEntry and not inTrade
            sState   := 4
            sFillEvt := true
            inTrade  := true
            label.new(bar_index, high, "SELL", style=label.style_label_down,
                      color=color.red, textcolor=color.white, size=size.small)
        else if bar_index - sArmBar > maxBarsFill
            sState := 0
    else if sState == 4
        // Conservative: if SL and TP are touched in the same bar, count it as SL
        if high >= sSL
            sSlEvt := true
        else if low <= sTP
            sTpEvt := true
        if sSlEvt or sTpEvt
            sState  := 5
            inTrade := false
            label.new(bar_index, sSlEvt ? sSL : sTP, sSlEvt ? "SL ✗" : "TP ✓",
                      style=sSlEvt ? label.style_label_down : label.style_label_up,
                      color=sSlEvt ? color.orange : color.teal, textcolor=color.white, size=size.small)

    if sState == 3 or sState == 4
        line.set_x2(sEntryLn, bar_index)
        line.set_x2(sSlLn,    bar_index)
        line.set_x2(sTpLn,    bar_index)

// ═══ LONG: sweep of previous Low ═════════════════════════════════════════════
if enableLong and not na(pdl)
    if lState == 0 and low < pdl and inSess and not na(lastSwingHigh) and lastSwingHigh > pdl
        lState    := 1
        lSweepEvt := true
        lExtreme  := low
        lSweepBar := bar_index
        lMss      := lastSwingHigh
        lMssPivot := lastSwingHighBar
        lFvgTop   := na
        lFvgBot   := na
        lLiqLbl   := label.new(bar_index, low, "Liq", style=label.style_label_up,
                          color=color.new(color.blue, 70), textcolor=color.white, size=size.small)
    else if lState == 1
        if low < lExtreme
            lExtreme := low
            label.set_xy(lLiqLbl, bar_index, low)
            if not na(lastSwingHigh) and lastSwingHighBar > lMssPivot and lastSwingHigh > close
                lMss      := lastSwingHigh
                lMssPivot := lastSwingHighBar
        if close > lMss
            lState  := 2
            lMssEvt := true
            lMssBar := bar_index
            line.new(lMssPivot, lMss, bar_index, lMss, color=color.gray, style=line.style_dotted, width=2)
            label.new(math.round((lMssPivot + bar_index) / 2), lMss, "MSS", style=label.style_label_down,
                      color=color.new(color.gray, 100), textcolor=color.gray, size=size.small)
        else if bar_index - lSweepBar > maxBarsMss
            lState := 0

    if (lState == 1 or lState == 2) and bullFvg and bar_index - 2 >= lSweepBar
        lFvgTop := low
        lFvgBot := high[2]
        lFvgBar := bar_index - 2
    if not na(lFvgBot) and close < lFvgBot
        lFvgTop := na
        lFvgBot := na

    if lState == 2
        if not na(lFvgTop) and not inTrade
            lEntry := entryMode == "FVG Edge" ? lFvgTop : (lFvgTop + lFvgBot) / 2
            lSL    := lExtreme - atr * slBufAtr
            risk    = lEntry - lSL
            lTP    := tpMode == "Risk:Reward" ? lEntry + risk * rr : pdh
            if risk > 0 and lTP > lEntry
                box.new(lFvgBar, lFvgTop, bar_index + 10, lFvgBot, border_color=color.new(color.green, 40),
                        bgcolor=color.new(color.green, 85), text="FVG", text_color=color.gray, text_size=size.small)
                lEntryLn := line.new(bar_index, lEntry, bar_index + 1, lEntry, color=color.green,  width=2)
                lSlLn    := line.new(bar_index, lSL,    bar_index + 1, lSL,    color=color.orange, style=line.style_dashed)
                lTpLn    := line.new(bar_index, lTP,    bar_index + 1, lTP,    color=color.teal,   style=line.style_dashed)
                lState  := 3
                lArmEvt := true
                lArmBar := bar_index
            else
                lState := 5
        else if bar_index - lMssBar > maxBarsFvg
            lState := 0

    if lState == 3 and bar_index > lArmBar
        if low < lSL
            lState := 0
        else if low <= lEntry and not inTrade
            lState   := 4
            lFillEvt := true
            inTrade  := true
            label.new(bar_index, low, "BUY", style=label.style_label_up,
                      color=color.green, textcolor=color.white, size=size.small)
        else if bar_index - lArmBar > maxBarsFill
            lState := 0
    else if lState == 4
        if low <= lSL
            lSlEvt := true
        else if high >= lTP
            lTpEvt := true
        if lSlEvt or lTpEvt
            lState  := 5
            inTrade := false
            label.new(bar_index, lSlEvt ? lSL : lTP, lSlEvt ? "SL ✗" : "TP ✓",
                      style=lSlEvt ? label.style_label_up : label.style_label_down,
                      color=lSlEvt ? color.orange : color.teal, textcolor=color.white, size=size.small)

    if lState == 3 or lState == 4
        line.set_x2(lEntryLn, bar_index)
        line.set_x2(lSlLn,    bar_index)
        line.set_x2(lTpLn,    bar_index)

// One trade at a time: once a side is entered, drop the other side's armed entry
if sState == 4 and lState == 3
    lState := 0
if lState == 4 and sState == 3
    sState := 0

// ─── PLOTS ────────────────────────────────────────────────────────────────────
plot(showLevels ? pdh : na, "Previous High", color=color.new(color.gray, 0), style=plot.style_linebr)
plot(showLevels ? pdl : na, "Previous Low",  color=color.new(color.gray, 0), style=plot.style_linebr)
bgcolor(newPeriod ? color.new(color.gray, 85) : na, title="New Period")

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(sSweepEvt, "Short: High swept",    "Liq: previous High swept on {{ticker}}")
alertcondition(sMssEvt,   "Short: MSS",           "Bearish MSS after High sweep on {{ticker}}")
alertcondition(sArmEvt,   "Short: FVG entry set", "Bearish FVG – sell limit set on {{ticker}}")
alertcondition(sFillEvt,  "Short: Entry filled",  "Short entry filled from FVG on {{ticker}} @ {{close}}")
alertcondition(lSweepEvt, "Long: Low swept",      "Liq: previous Low swept on {{ticker}}")
alertcondition(lMssEvt,   "Long: MSS",            "Bullish MSS after Low sweep on {{ticker}}")
alertcondition(lArmEvt,   "Long: FVG entry set",  "Bullish FVG – buy limit set on {{ticker}}")
alertcondition(lFillEvt,  "Long: Entry filled",   "Long entry filled from FVG on {{ticker}} @ {{close}}")
alertcondition(sTpEvt or lTpEvt, "Take profit hit", "Take profit hit on {{ticker}}")
alertcondition(sSlEvt or lSlEvt, "Stop loss hit",   "Stop loss hit on {{ticker}}")

// Single "any alert()" alert with full details (create one alert → "Any alert() function call")
if sArmEvt
    alert("SELL LIMIT " + syminfo.ticker + " | Entry " + str.tostring(sEntry, format.mintick) +
          " | SL " + str.tostring(sSL, format.mintick) + " | TP " + str.tostring(sTP, format.mintick), alert.freq_once_per_bar_close)
if lArmEvt
    alert("BUY LIMIT " + syminfo.ticker + " | Entry " + str.tostring(lEntry, format.mintick) +
          " | SL " + str.tostring(lSL, format.mintick) + " | TP " + str.tostring(lTP, format.mintick), alert.freq_once_per_bar_close)

// ─── INFO TABLE ───────────────────────────────────────────────────────────────
stateText(s) =>
    s == 0 ? "Waiting sweep" : s == 1 ? "Swept – wait MSS" : s == 2 ? "MSS – wait FVG" : s == 3 ? "Entry armed" : s == 4 ? "In trade" : "Done today"

var table info = table.new(position.top_right, 2, 3,
     bgcolor      = color.new(color.black, 80),
     border_color = color.new(color.white, 60),
     border_width = 1)

if showTable and barstate.islast
    table.cell(info, 0, 0, "Side",             text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 0, "State",            text_color=color.silver, text_size=size.small)
    table.cell(info, 0, 1, "High sweep (S)",   text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 1, stateText(sState),  text_color=color.red,    text_size=size.small)
    table.cell(info, 0, 2, "Low sweep (L)",    text_color=color.white,  text_size=size.small)
    table.cell(info, 1, 2, stateText(lState),  text_color=color.green,  text_size=size.small)

if timeframe.in_seconds() >= timeframe.in_seconds(htf)
    runtime.error("Use a chart timeframe lower than the Liquidity Timeframe (e.g. 5m chart with D levels).")
