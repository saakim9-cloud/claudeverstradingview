//@version=5
// ICT model: Liquidity Sweep → HTF Delivery → CHoCH + FVG retest (or iFVG + CISD) on 1m
// Built for 1m charts (XAUUSD, BTC, ETH). Times are New York time.
strategy(
     title                   = "ICT Sweep → CHoCH/FVG ou iFVG/CISD + DXY (Stratégie)",
     shorttitle              = "ICT Strat",
     overlay                 = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 5,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     slippage                = 2,
     process_orders_on_close = true,
     max_boxes_count         = 300,
     max_lines_count         = 300,
     max_labels_count        = 300)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
G_KZ    = "1. Sessions (heure NY)"
sAsia   = input.session("2000-0000", "Asia", inline="as", group=G_KZ)
cAsia   = input.color(color.new(#7E57C2, 85), "", inline="as", group=G_KZ)
tAsia   = input.bool(false, "Signaux", inline="as", group=G_KZ)
kzLon   = input.session("0200-0500", "London", inline="lo", group=G_KZ)
cLon    = input.color(color.new(#2962FF, 85), "", inline="lo", group=G_KZ)
tLon    = input.bool(true, "Signaux", inline="lo", group=G_KZ)
kzNYAM  = input.session("0700-1000", "NY AM", inline="am", group=G_KZ)
cNYAM   = input.color(color.new(#FF9800, 87), "", inline="am", group=G_KZ)
tNYAM   = input.bool(true, "Signaux", inline="am", group=G_KZ)
kzNYPM  = input.session("1330-1600", "NY PM", inline="pm", group=G_KZ)
cNYPM   = input.color(color.new(#26A69A, 87), "", inline="pm", group=G_KZ)
tNYPM   = input.bool(true, "Signaux", inline="pm", group=G_KZ)
useKZ   = input.bool(true, "Signaux seulement dans les sessions cochées", group=G_KZ)
showKZ  = input.bool(true, "Colorer les sessions", group=G_KZ)
showKZL = input.bool(true, "Afficher le nom des sessions", group=G_KZ)

G_BIAS   = "2. Biais HTF"
biasMode = input.string("EMA HTF", "Biais", options=["EMA HTF", "Désactivé"], group=G_BIAS)
biasTF   = input.timeframe("240", "Timeframe biais", group=G_BIAS)
biasLen  = input.int(50, "Longueur EMA", minval=1, group=G_BIAS)

G_LIQ      = "3. Liquidité"
usePD      = input.bool(true, "PDH / PDL", group=G_LIQ)
useAsia    = input.bool(true, "Asia High / Low", group=G_LIQ)
usePivots  = input.bool(true, "Swing highs / lows", inline="piv", group=G_LIQ)
pivLen     = input.int(15, "longueur", minval=2, inline="piv", group=G_LIQ)
maxLevels  = input.int(12, "Niveaux max gardés (par côté)", minval=1, group=G_LIQ)
sweepWin   = input.int(30, "Barres max entre sweep et entrée", minval=1, group=G_LIQ)
showLiq    = input.bool(true, "Afficher PDH/PDL & Asia", group=G_LIQ)

G_DEL     = "4. HTF Delivery"
delMode   = input.string("FVG HTF ou Discount/Premium", "Mode",
     options=["FVG HTF", "Discount/Premium", "FVG HTF ou Discount/Premium", "Désactivé"], group=G_DEL)
fvgTF     = input.timeframe("60", "Timeframe FVG HTF", group=G_DEL)
fvgTolAtr = input.float(0.5, "Tolérance sous/au-dessus du FVG (x ATR)", minval=0, step=0.1, group=G_DEL)
rangeTF   = input.timeframe("240", "Timeframe dealing range", group=G_DEL)
rangeLen  = input.int(20, "Barres du dealing range", minval=2, group=G_DEL)
showHtfFvg= input.bool(true, "Afficher les FVG HTF", group=G_DEL)

G_CONF    = "5. Confirmation 1m"
confMode  = input.string("CHoCH + FVG", "Modèle de confirmation", options=["CHoCH + FVG", "iFVG + CISD"], group=G_CONF)
chochLen  = input.int(3, "Swing pour le CHoCH (longueur)", minval=1, group=G_CONF)
entryMode = input.string("Retest du FVG", "Entrée (CHoCH + FVG)", options=["Retest du FVG", "Clôture du CHoCH"], group=G_CONF)
retestWin = input.int(30, "Barres max pour le retest du FVG", minval=1, group=G_CONF)
reqIfvg   = input.bool(true, "Exiger iFVG", group=G_CONF)
reqCisd   = input.bool(true, "Exiger CISD", group=G_CONF)
minFvgAtr = input.float(0.25, "Taille min FVG (x ATR)", minval=0, step=0.05, group=G_CONF)
fvgMaxAge = input.int(40, "Âge max FVG avant inversion (barres)", minval=2, group=G_CONF)
preSweep  = input.int(5, "FVG formé au plus N barres avant le sweep", minval=0, group=G_CONF)
confWin   = input.int(5, "Écart max iFVG ↔ CISD (barres)", minval=0, group=G_CONF)

G_RISK  = "6. Risque"
slBuf   = input.float(0.1, "Buffer SL au-delà du sweep (x ATR)", minval=0, step=0.05, group=G_RISK)
tpMode  = input.string("Liquidité opposée", "Cible", options=["Liquidité opposée", "RR fixe"], group=G_RISK)
rrFixed = input.float(2.0, "RR fixe", minval=0.5, step=0.25, group=G_RISK)
minRR   = input.float(2.0, "RR minimum (mode liquidité)", minval=0.5, step=0.25, group=G_RISK)
atrLen  = input.int(14, "ATR", minval=1, group=G_RISK)

G_DXY     = "7. Filtre DXY"
useDxy    = input.bool(true, "Activer le filtre DXY", group=G_DXY)
dxySym    = input.symbol("TVC:DXY", "Symbole DXY", group=G_DXY)
dxyTF     = input.timeframe("60", "Timeframe DXY", group=G_DXY)
dxyPivLen = input.int(5, "Longueur swing support/résistance", minval=2, group=G_DXY)
dxyMaxAge = input.int(24, "Cassure valide pendant N bougies DXY (0 = illimité)", minval=0, group=G_DXY)
showDxy   = input.bool(true, "Afficher le statut DXY", group=G_DXY)

isIC = confMode == "iFVG + CISD"

// ─── COMMON ───────────────────────────────────────────────────────────────────
TZ  = "America/New_York"
atr = ta.atr(atrLen)

inSess(s) => not na(time(timeframe.period, s, TZ))

inAsia     = inSess(sAsia)
inLon      = inSess(kzLon)
inNYAM     = inSess(kzNYAM)
inNYPM     = inSess(kzNYPM)
inKillzone = not useKZ or (tAsia and inAsia) or (tLon and inLon) or (tNYAM and inNYAM) or (tNYPM and inNYPM)

sessCol = inAsia ? cAsia : inLon ? cLon : inNYAM ? cNYAM : inNYPM ? cNYPM : na
bgcolor(showKZ ? sessCol : na, title="Sessions")

sessName(bool startNow, string txt, color col) =>
    if showKZL and startNow
        label.new(bar_index, high, txt, yloc=yloc.abovebar, style=label.style_none, textcolor=color.new(col, 0), size=size.small)
    0

sessName(inAsia and not inAsia[1], "ASIA", cAsia)
sessName(inLon and not inLon[1], "LONDON", cLon)
sessName(inNYAM and not inNYAM[1], "NY AM", cNYAM)
sessName(inNYPM and not inNYPM[1], "NY PM", cNYPM)

// ─── 2. BIAS ──────────────────────────────────────────────────────────────────
[htfC, htfE] = request.security(syminfo.tickerid, biasTF, [close[1], ta.ema(close, biasLen)[1]], lookahead=barmerge.lookahead_on)
biasBull = biasMode == "Désactivé" or htfC > htfE
biasBear = biasMode == "Désactivé" or htfC < htfE

// ─── 7. DXY FILTER ────────────────────────────────────────────────────────────
// State on confirmed DXY candles: -1 = closed below last swing-low support (gold bullish)
//                                 +1 = closed above last swing-high resistance (gold bearish)
dxyState() =>
    dph = ta.pivothigh(high, dxyPivLen, dxyPivLen)
    dpl = ta.pivotlow(low, dxyPivLen, dxyPivLen)
    var float res = na
    var float sup = na
    var int   st  = 0
    var int   brk = na
    if not na(dph)
        res := dph
    if not na(dpl)
        sup := dpl
    if not na(sup) and close < sup
        st  := -1
        brk := bar_index
        sup := na
    if not na(res) and close > res
        st  := 1
        brk := bar_index
        res := na
    [st[1], bar_index[1] - brk[1]]

[dxySt, dxyAge] = request.security(dxySym, dxyTF, dxyState(), lookahead=barmerge.lookahead_on)
dxyFresh   = dxyMaxAge == 0 or (not na(dxyAge) and dxyAge <= dxyMaxAge)
dxyBullOk  = not useDxy or (dxySt == -1 and dxyFresh)
dxyBearOk  = not useDxy or (dxySt == 1 and dxyFresh)

var table dxyTbl = table.new(position.top_right, 1, 1)
if showDxy and useDxy and barstate.islast
    txt = dxySt == -1 ? "DXY " + dxyTF + " : support cassé ↓ → BUY or" : dxySt == 1 ? "DXY " + dxyTF + " : résistance cassée ↑ → SELL or" : "DXY " + dxyTF + " : neutre"
    txt := txt + (dxySt != 0 and not dxyFresh ? " (expiré)" : "")
    bg  = not dxyFresh or dxySt == 0 ? #424242 : dxySt == -1 ? #00C853 : #D50000
    table.cell(dxyTbl, 0, 0, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

// ─── 3. LIQUIDITY LEVELS ──────────────────────────────────────────────────────
var float[] liqHighs = array.new_float()
var float[] liqLows  = array.new_float()

addLevel(float[] arr, float lvl) =>
    if not na(lvl) and not array.includes(arr, lvl)
        array.push(arr, lvl)
        if array.size(arr) > maxLevels
            array.shift(arr)
    0

// Previous day high / low
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
if usePD and pdh != pdh[1]
    addLevel(liqHighs, pdh)
if usePD and pdl != pdl[1]
    addLevel(liqLows, pdl)

// Asia range
var float asiaH = na
var float asiaL = na
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(asiaH, high)
    asiaL := math.min(asiaL, low)
if useAsia and not inAsia and inAsia[1]
    addLevel(liqHighs, asiaH)
    addLevel(liqLows, asiaL)

// Swing highs / lows
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if usePivots and not na(ph)
    addLevel(liqHighs, ph)
if usePivots and not na(pl)
    addLevel(liqLows, pl)

plot(showLiq and usePD ? pdh : na, "PDH", color.new(#FFEB3B, 10), 1, plot.style_stepline)
plot(showLiq and usePD ? pdl : na, "PDL", color.new(#FFEB3B, 10), 1, plot.style_stepline)
plot(showLiq and useAsia and not inAsia ? asiaH : na, "Asia High", color.new(#B388FF, 10), 1, plot.style_linebr)
plot(showLiq and useAsia and not inAsia ? asiaL : na, "Asia Low", color.new(#B388FF, 10), 1, plot.style_linebr)

// ─── 4. HTF DELIVERY ──────────────────────────────────────────────────────────
// HTF FVGs from confirmed HTF candles (non-repainting)
[hL1, hH3, hH1, hL3, hT1] = request.security(syminfo.tickerid, fvgTF,
     [low[1], high[3], high[1], low[3], time[1]], lookahead=barmerge.lookahead_on)
newHtfBar = hT1 != nz(hT1[1])

var float[] hBullTop = array.new_float()
var float[] hBullBot = array.new_float()
var box[]   hBullBox = array.new<box>()
var float[] hBearTop = array.new_float()
var float[] hBearBot = array.new_float()
var box[]   hBearBox = array.new<box>()

pushHtfFvg(float[] tops, float[] bots, box[] boxes, float top, float bot, color col) =>
    array.push(tops, top)
    array.push(bots, bot)
    array.push(boxes, showHtfFvg ? box.new(bar_index, top, bar_index, bot, border_color=na, bgcolor=col) : na)
    if array.size(tops) > 10
        array.shift(tops)
        array.shift(bots)
        box.delete(array.shift(boxes))
    0

if newHtfBar and hL1 > hH3
    pushHtfFvg(hBullTop, hBullBot, hBullBox, hL1, hH3, color.new(#00E676, 88))
if newHtfBar and hH1 < hL3
    pushHtfFvg(hBearTop, hBearBot, hBearBox, hL3, hH1, color.new(#FF5252, 88))

inHtfBullFvg(float p) =>
    bool r = false
    n = array.size(hBullTop)
    if n > 0
        for i = 0 to n - 1
            if p <= array.get(hBullTop, i) and p >= array.get(hBullBot, i) - fvgTolAtr * atr
                r := true
    r

inHtfBearFvg(float p) =>
    bool r = false
    n = array.size(hBearTop)
    if n > 0
        for i = 0 to n - 1
            if p >= array.get(hBearBot, i) and p <= array.get(hBearTop, i) + fvgTolAtr * atr
                r := true
    r

// Dealing range (premium / discount)
[rngH, rngL] = request.security(syminfo.tickerid, rangeTF,
     [ta.highest(high, rangeLen)[1], ta.lowest(low, rangeLen)[1]], lookahead=barmerge.lookahead_on)
eq = (rngH + rngL) / 2

deliveryBull(float p) =>
    fvgOk  = inHtfBullFvg(p)
    discOk = p < eq
    switch delMode
        "FVG HTF"          => fvgOk
        "Discount/Premium" => discOk
        "Désactivé"        => true
        => fvgOk or discOk

deliveryBear(float p) =>
    fvgOk  = inHtfBearFvg(p)
    premOk = p > eq
    switch delMode
        "FVG HTF"          => fvgOk
        "Discount/Premium" => premOk
        "Désactivé"        => true
        => fvgOk or premOk

// ─── CISD reference: open of the delivery sequence into the extreme ──────────
cisdLevelBull() =>
    float lvl = na
    for k = 0 to 50
        if close[k] < open[k]
            lvl := open[k]
        else if not na(lvl)
            break
    lvl

cisdLevelBear() =>
    float lvl = na
    for k = 0 to 50
        if close[k] > open[k]
            lvl := open[k]
        else if not na(lvl)
            break
    lvl

// ─── 3b. SWEEP DETECTION ──────────────────────────────────────────────────────
bullSweepNow = false
bearSweepNow = false
if array.size(liqLows) > 0
    for i = array.size(liqLows) - 1 to 0
        lvl = array.get(liqLows, i)
        if low < lvl
            if close > lvl
                bullSweepNow := true
            array.remove(liqLows, i)
if array.size(liqHighs) > 0
    for i = array.size(liqHighs) - 1 to 0
        lvl = array.get(liqHighs, i)
        if high > lvl
            if close < lvl
                bearSweepNow := true
            array.remove(liqHighs, i)

// Internal swings (CHoCH reference)
iph = ta.pivothigh(high, chochLen, chochLen)
ipl = ta.pivotlow(low, chochLen, chochLen)
var float lastSwH = na
var float lastSwL = na
if not na(iph)
    lastSwH := iph
if not na(ipl)
    lastSwL := ipl

// Sweep state
var float bullChoch    = na
var int   bullChochBar = na
var float bullFvgT     = na
var float bullFvgB     = na
var float bearChoch    = na
var int   bearChochBar = na
var float bearFvgT     = na
var float bearFvgB     = na
var float bullExt  = na
var int   bullBar  = na
var bool  bullDel  = false
var float bullCisd = na
var int   bullIfvgBar = na
var int   bullCisdBar = na

var float bearExt  = na
var int   bearBar  = na
var bool  bearDel  = false
var float bearCisd = na
var int   bearIfvgBar = na
var int   bearCisdBar = na

if bullSweepNow or (not na(bullBar) and low < bullExt)
    if bullSweepNow and na(bullBar)
        label.new(bar_index, low, "SSL", style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.white, size=size.tiny)
    bullBar     := bullSweepNow or na(bullBar) ? bar_index : bullBar
    bullExt     := low
    bullDel     := deliveryBull(low)
    bullCisd    := cisdLevelBull()
    bullIfvgBar := na
    bullCisdBar := na
    if bullSweepNow
        bullChoch := lastSwH
    bullChochBar := na
    bullFvgT     := na
    bullFvgB     := na

if bearSweepNow or (not na(bearBar) and high > bearExt)
    if bearSweepNow and na(bearBar)
        label.new(bar_index, high, "BSL", style=label.style_label_down, color=color.new(#D50000, 0), textcolor=color.white, size=size.tiny)
    bearBar     := bearSweepNow or na(bearBar) ? bar_index : bearBar
    bearExt     := high
    bearDel     := deliveryBear(high)
    bearCisd    := cisdLevelBear()
    bearIfvgBar := na
    bearCisdBar := na
    if bearSweepNow
        bearChoch := lastSwL
    bearChochBar := na
    bearFvgT     := na
    bearFvgB     := na

// HTF FVG invalidation (after delivery check) + extend boxes
if array.size(hBullTop) > 0
    for i = array.size(hBullTop) - 1 to 0
        if close < array.get(hBullBot, i)
            array.remove(hBullTop, i)
            array.remove(hBullBot, i)
            box.delete(array.remove(hBullBox, i))
        else
            box.set_right(array.get(hBullBox, i), bar_index)
if array.size(hBearTop) > 0
    for i = array.size(hBearTop) - 1 to 0
        if close > array.get(hBearTop, i)
            array.remove(hBearTop, i)
            array.remove(hBearBot, i)
            box.delete(array.remove(hBearBox, i))
        else
            box.set_right(array.get(hBearBox, i), bar_index)

// ─── 5a. iFVG ON CHART TIMEFRAME ──────────────────────────────────────────────
var float[] bearFTop = array.new_float()
var float[] bearFBot = array.new_float()
var int[]   bearFBar = array.new_int()
var float[] bullFTop = array.new_float()
var float[] bullFBot = array.new_float()
var int[]   bullFBar = array.new_int()

// New 1m FVGs (bar_index - 1 = middle candle)
if high < low[2] and (low[2] - high) >= minFvgAtr * atr
    array.push(bearFTop, low[2])
    array.push(bearFBot, high)
    array.push(bearFBar, bar_index - 1)
if low > high[2] and (low - high[2]) >= minFvgAtr * atr
    array.push(bullFTop, low)
    array.push(bullFBot, high[2])
    array.push(bullFBar, bar_index - 1)

// Bearish FVG closed through upward → bullish iFVG
if array.size(bearFTop) > 0
    for i = array.size(bearFTop) - 1 to 0
        fb  = array.get(bearFBar, i)
        top = array.get(bearFTop, i)
        if bar_index - fb > fvgMaxAge
            array.remove(bearFTop, i)
            array.remove(bearFBot, i)
            array.remove(bearFBar, i)
        else if close > top
            if not na(bullBar) and fb >= bullBar - preSweep and na(bullIfvgBar)
                bullIfvgBar := bar_index
                if isIC
                    box.new(fb, top, bar_index, array.get(bearFBot, i), border_color=color.new(#00E676, 20), bgcolor=color.new(#00E676, 80), text="iFVG", text_size=size.tiny, text_color=#00E676)
            array.remove(bearFTop, i)
            array.remove(bearFBot, i)
            array.remove(bearFBar, i)

// Bullish FVG closed through downward → bearish iFVG
if array.size(bullFTop) > 0
    for i = array.size(bullFTop) - 1 to 0
        fb  = array.get(bullFBar, i)
        bot = array.get(bullFBot, i)
        if bar_index - fb > fvgMaxAge
            array.remove(bullFTop, i)
            array.remove(bullFBot, i)
            array.remove(bullFBar, i)
        else if close < bot
            if not na(bearBar) and fb >= bearBar - preSweep and na(bearIfvgBar)
                bearIfvgBar := bar_index
                if isIC
                    box.new(fb, array.get(bullFTop, i), bar_index, bot, border_color=color.new(#FF5252, 20), bgcolor=color.new(#FF5252, 80), text="iFVG", text_size=size.tiny, text_color=#FF5252)
            array.remove(bullFTop, i)
            array.remove(bullFBot, i)
            array.remove(bullFBar, i)

// ─── 5b. CISD ─────────────────────────────────────────────────────────────────
if isIC and not na(bullBar) and na(bullCisdBar) and not na(bullCisd) and close > bullCisd
    bullCisdBar := bar_index
    line.new(bullBar, bullCisd, bar_index, bullCisd, color=#00E676, style=line.style_dashed)
    label.new(bar_index, bullCisd, "CISD", style=label.style_label_left, color=color.new(#00E676, 100), textcolor=#00E676, size=size.tiny)
if isIC and not na(bearBar) and na(bearCisdBar) and not na(bearCisd) and close < bearCisd
    bearCisdBar := bar_index
    line.new(bearBar, bearCisd, bar_index, bearCisd, color=#FF5252, style=line.style_dashed)
    label.new(bar_index, bearCisd, "CISD", style=label.style_label_left, color=color.new(#FF5252, 100), textcolor=#FF5252, size=size.tiny)

// ─── 5c. CHoCH + FVG ──────────────────────────────────────────────────────────
// FVG left by the displacement leg after the sweep (up to the CHoCH candle)
if not isIC and not na(bullBar) and na(bullChochBar) and low > high[2] and (low - high[2]) >= minFvgAtr * atr and bar_index - 1 >= bullBar
    bullFvgT := low
    bullFvgB := high[2]
if not isIC and not na(bearBar) and na(bearChochBar) and high < low[2] and (low[2] - high) >= minFvgAtr * atr and bar_index - 1 >= bearBar
    bearFvgT := low[2]
    bearFvgB := high

// CHoCH: close beyond the last internal swing before the sweep
if not isIC and not na(bullBar) and na(bullChochBar) and not na(bullChoch) and close > bullChoch
    bullChochBar := bar_index
    line.new(bullBar, bullChoch, bar_index, bullChoch, color=#00E676, width=1)
    label.new(bar_index, bullChoch, "CHoCH", style=label.style_label_left, color=color.new(#00E676, 100), textcolor=#00E676, size=size.tiny)
    if not na(bullFvgT)
        box.new(bar_index, bullFvgT, bar_index + 10, bullFvgB, border_color=color.new(#00E676, 20), bgcolor=color.new(#00E676, 80), text="FVG", text_size=size.tiny, text_color=#00E676)
if not isIC and not na(bearBar) and na(bearChochBar) and not na(bearChoch) and close < bearChoch
    bearChochBar := bar_index
    line.new(bearBar, bearChoch, bar_index, bearChoch, color=#FF5252, width=1)
    label.new(bar_index, bearChoch, "CHoCH", style=label.style_label_left, color=color.new(#FF5252, 100), textcolor=#FF5252, size=size.tiny)
    if not na(bearFvgT)
        box.new(bar_index, bearFvgT, bar_index + 10, bearFvgB, border_color=color.new(#FF5252, 20), bgcolor=color.new(#FF5252, 80), text="FVG", text_size=size.tiny, text_color=#FF5252)

// Entry trigger: retest of the FVG (or CHoCH close in aggressive mode)
bullChTrig  = false
bullChEntry = float(na)
if not isIC and not na(bullBar) and not na(bullChochBar) and not na(bullFvgT)
    if entryMode == "Clôture du CHoCH"
        if bar_index == bullChochBar
            bullChTrig  := true
            bullChEntry := close
    else if bar_index > bullChochBar
        if close < bullFvgB
            bullBar := na
        else if low <= bullFvgT
            bullChTrig  := true
            bullChEntry := math.min(open, bullFvgT)

bearChTrig  = false
bearChEntry = float(na)
if not isIC and not na(bearBar) and not na(bearChochBar) and not na(bearFvgT)
    if entryMode == "Clôture du CHoCH"
        if bar_index == bearChochBar
            bearChTrig  := true
            bearChEntry := close
    else if bar_index > bearChochBar
        if close > bearFvgT
            bearBar := na
        else if high >= bearFvgB
            bearChTrig  := true
            bearChEntry := math.max(open, bearFvgB)

// ─── SETUP EVALUATION ─────────────────────────────────────────────────────────
confirmed(int ifvgBar, int cisdBar) =>
    bool ok = false
    if reqIfvg and reqCisd
        ok := not na(ifvgBar) and not na(cisdBar) and math.abs(ifvgBar - cisdBar) <= confWin and (ifvgBar == bar_index or cisdBar == bar_index)
    else if reqIfvg
        ok := ifvgBar == bar_index
    else
        ok := cisdBar == bar_index
    ok

nearestAbove(float[] arr, float p) =>
    float r = na
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            v = array.get(arr, i)
            if v > p and (na(r) or v < r)
                r := v
    r

nearestBelow(float[] arr, float p) =>
    float r = na
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            v = array.get(arr, i)
            if v < p and (na(r) or v > r)
                r := v
    r

flat = strategy.position_size == 0

// Long
longSignal = false
bullTrig = isIC ? (not na(bullBar) and confirmed(bullIfvgBar, bullCisdBar)) : bullChTrig
if bullTrig
    entry = close
    sl    = bullExt - slBuf * atr
    risk  = entry - sl
    liqTp = nearestAbove(liqHighs, entry)
    tp    = tpMode == "RR fixe" ? entry + risk * rrFixed : (not na(liqTp) and (liqTp - entry) >= minRR * risk ? liqTp : na)
    if flat and inKillzone and biasBull and bullDel and dxyBullOk and risk > 0 and not na(tp)
        longSignal := true
        strategy.entry("Long", strategy.long)
        strategy.exit("XL", "Long", stop=sl, limit=tp)
        label.new(bar_index, low, "BUY\n" + str.tostring(entry, format.mintick) + (useDxy ? "\nDXY ✔" : ""), style=label.style_label_up, yloc=yloc.belowbar, color=#00C853, textcolor=color.white, size=size.normal)
        line.new(bar_index, tp, bar_index + 15, tp, color=#00E676, width=2)
        line.new(bar_index, sl, bar_index + 15, sl, color=#FF5252, width=2)
        alert("ICT BUY " + syminfo.ticker + " | entrée " + str.tostring(entry, format.mintick) + " SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    // One shot per sweep
    bullBar := na

// Short
shortSignal = false
bearTrig = isIC ? (not na(bearBar) and confirmed(bearIfvgBar, bearCisdBar)) : bearChTrig
if bearTrig
    entry = close
    sl    = bearExt + slBuf * atr
    risk  = sl - entry
    liqTp = nearestBelow(liqLows, entry)
    tp    = tpMode == "RR fixe" ? entry - risk * rrFixed : (not na(liqTp) and (entry - liqTp) >= minRR * risk ? liqTp : na)
    if flat and inKillzone and biasBear and bearDel and dxyBearOk and risk > 0 and not na(tp)
        shortSignal := true
        strategy.entry("Short", strategy.short)
        strategy.exit("XS", "Short", stop=sl, limit=tp)
        label.new(bar_index, high, "SELL\n" + str.tostring(entry, format.mintick) + (useDxy ? "\nDXY ✔" : ""), style=label.style_label_down, yloc=yloc.abovebar, color=#D50000, textcolor=color.white, size=size.normal)
        line.new(bar_index, tp, bar_index + 15, tp, color=#00E676, width=2)
        line.new(bar_index, sl, bar_index + 15, sl, color=#FF5252, width=2)
        alert("ICT SELL " + syminfo.ticker + " | entrée " + str.tostring(entry, format.mintick) + " SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    bearBar := na

// Expire stale sweeps
bullRef = not isIC and not na(bullChochBar) ? bullChochBar : bullBar
bullLim = not isIC and not na(bullChochBar) ? retestWin : sweepWin
if not na(bullBar) and bar_index - bullRef > bullLim
    bullBar := na
bearRef = not isIC and not na(bearChochBar) ? bearChochBar : bearBar
bearLim = not isIC and not na(bearChochBar) ? retestWin : sweepWin
if not na(bearBar) and bar_index - bearRef > bearLim
    bearBar := na
