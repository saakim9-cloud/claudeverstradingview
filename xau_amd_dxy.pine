//@version=6
indicator("AMD Power of 3 + DXY (M5 / M15) [Akim]", "AMD DXY", overlay = true, max_boxes_count = 200, max_lines_count = 500, max_labels_count = 500)

// AMD / Power of 3 for XAUUSD on M5 or M15 (times in New York zone, DST handled).
//   A  Accumulation : Asia range (default 20:00-00:00 NY = 02:00-06:00 Paris).
//   M  Manipulation : during the trade window (default 00:00-11:00 NY) price sweeps the Asia high or low.
//   D  Distribution : after the sweep, a CHoCH on the chart TF in the opposite direction = signal.
//                     Sweep of the Asia LOW + bullish CHoCH -> BUY. Sweep of the Asia HIGH + bearish CHoCH -> SELL.
//   DXY confirmation (gold moves against the dollar):
//     BUY gold needs DXY bearish, SELL gold needs DXY bullish (MSS on DXY and/or DXY vs its midnight open).
// SL beyond the manipulation extreme, TP = fixed R:R or opposite side of the Asia range. One signal per day.

const string TZ = "America/New_York"

// ===== Inputs =====
G_S      = "1. Sessions (New York time)"
accSess  = input.session("2000-0000", "A - Accumulation (Asia range)", group = G_S)
tradeWin = input.session("0000-1100", "M + D - Manipulation / signal window", group = G_S)
useAtrF  = input.bool(true, "Asia range size filter (daily ATR)", group = G_S)
rngMin   = input.float(0.15, "   Range min x daily ATR", step = 0.05, group = G_S)
rngMax   = input.float(1.0, "   Range max x daily ATR", step = 0.05, group = G_S)

G_D      = "2. Distribution (CHoCH)"
swLen    = input.int(3, "Swing length for CHoCH", minval = 1, maxval = 10, group = G_D)
maxDepth = input.float(1.5, "Max sweep depth beyond range (x ATR chart)", minval = 0.1, step = 0.1, group = G_D)

G_X      = "3. DXY confirmation"
dxyMode  = input.string("MSS DXY", "Mode", options = ["MSS DXY", "DXY vs midnight open", "Both", "Off"], group = G_X)
dxySym   = input.symbol("TVC:DXY", "DXY symbol", group = G_X)
dxyLen   = input.int(3, "DXY swing length", minval = 1, maxval = 10, group = G_X)
dxyAge   = input.int(24, "DXY MSS valid for N bars", minval = 1, group = G_X)

G_R      = "4. Risk"
slBuf    = input.float(0.2, "SL buffer beyond the sweep (x ATR)", minval = 0, step = 0.05, group = G_R)
tpMode   = input.string("Fixed R:R", "Target", options = ["Fixed R:R", "Opposite side of Asia range"], group = G_R)
rr       = input.float(2.0, "R:R", minval = 0.5, step = 0.25, group = G_R)
minRR    = input.float(1.5, "Min R:R (Asia range target)", minval = 0.5, step = 0.25, group = G_R)
atrLen   = input.int(14, "ATR length", group = G_R)

G_V      = "5. Display"
showBox  = input.bool(true, "Asia box + extended levels", group = G_V)
showBg   = input.bool(true, "Shade the signal window", group = G_V)
showTbl  = input.bool(true, "AMD checklist table", group = G_V)
cAcc     = input.color(color.new(#7E57C2, 80), "Accumulation", group = G_V)

// ===== Common =====
atr  = ta.atr(atrLen)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
inAcc   = not na(time(timeframe.period, accSess, TZ))
inTrade = not na(time(timeframe.period, tradeWin, TZ))

// ===== DXY =====
dxyF() =>
    float dph = ta.pivothigh(high, dxyLen, dxyLen)
    float dpl = ta.pivotlow(low, dxyLen, dxyLen)
    var float r  = na
    var float s  = na
    var int   st = 0
    var int   ag = 0
    var float mo = na
    if not na(dph)
        r := dph
    if not na(dpl)
        s := dpl
    ag += 1
    if not na(s) and close < s
        st := -1
        ag := 0
        s  := na
    if not na(r) and close > r
        st := 1
        ag := 0
        r  := na
    int d = dayofmonth(time, "America/New_York")
    if d != d[1]
        mo := open
    [st, ag, close, mo]

[dSt, dAg, dClose, dMo] = request.security(dxySym, timeframe.period, dxyF())
bool mssBear = dSt == -1 and dAg <= dxyAge
bool mssBull = dSt == 1 and dAg <= dxyAge
bool openBear = not na(dMo) and dClose < dMo
bool openBull = not na(dMo) and dClose > dMo
bool dxyOkBuy  = dxyMode == "Off" ? true : dxyMode == "MSS DXY" ? mssBear : dxyMode == "DXY vs midnight open" ? openBear : mssBear and openBear
bool dxyOkSell = dxyMode == "Off" ? true : dxyMode == "MSS DXY" ? mssBull : dxyMode == "DXY vs midnight open" ? openBull : mssBull and openBull

// ===== Chart swings (for the CHoCH) =====
float ph = ta.pivothigh(high, swLen, swLen)
float pl = ta.pivotlow(low, swLen, swLen)
var float lastPH = na
var int   lastPHb = na
var float lastPL = na
var int   lastPLb = na
if not na(ph)
    lastPH  := ph
    lastPHb := bar_index - swLen
if not na(pl)
    lastPL  := pl
    lastPLb := bar_index - swLen

// ===== A - Accumulation =====
var float aH = na
var float aL = na
var int   aStart = na
var int   aEndB = na
var bool  accDone = false
var bool  rangeOk = false
var bool  sweptL = false
var bool  sweptH = false
var float manL = na
var float manH = na
var bool  done = false
var string status = "Waiting for Asia"
var box   accBox = na
var line  lnH = na
var line  lnL = na

if inAcc and not inAcc[1]
    aH := high
    aL := low
    aStart := bar_index
    accDone := false
    sweptL := false
    sweptH := false
    manL := na
    manH := na
    done := false
    status := "A: building Asia range"
    if showBox
        accBox := box.new(bar_index, high, bar_index, low, border_color = color.new(#7E57C2, 30), bgcolor = cAcc, text = "A", text_color = color.new(#B388FF, 0), text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
else if inAcc
    aH := math.max(aH, high)
    aL := math.min(aL, low)
    if showBox and not na(accBox)
        accBox.set_right(bar_index)
        accBox.set_top(aH)
        accBox.set_bottom(aL)

if not inAcc and inAcc[1]
    accDone := true
    aEndB := bar_index
    rangeOk := not useAtrF or ((aH - aL) >= rngMin * atrD and (aH - aL) <= rngMax * atrD)
    status := rangeOk ? "M: waiting for a sweep of Asia H/L" : "No trade: Asia range outside ATR filter"
    if showBox
        lnH := line.new(bar_index, aH, bar_index, aH, color = color.new(#B388FF, 20), style = line.style_dashed)
        lnL := line.new(bar_index, aL, bar_index, aL, color = color.new(#B388FF, 20), style = line.style_dashed)

bool live = accDone and rangeOk and not done and inTrade
if accDone and inTrade and showBox and not na(lnH)
    lnH.set_x2(bar_index)
    lnL.set_x2(bar_index)

// ===== M - Manipulation =====
bool newSweepL = false
bool newSweepH = false
if live
    if low < aL
        newSweepL := not sweptL
        sweptL := true
        manL := na(manL) ? low : math.min(manL, low)
    if high > aH
        newSweepH := not sweptH
        sweptH := true
        manH := na(manH) ? high : math.max(manH, high)
    if newSweepL
        status := "M: Asia LOW swept -> waiting for bullish CHoCH (D)"
    if newSweepH
        status := "M: Asia HIGH swept -> waiting for bearish CHoCH (D)"

// Sweep too deep = real breakout, not a manipulation
bool deepL = sweptL and not na(manL) and aL - manL > maxDepth * atr
bool deepH = sweptH and not na(manH) and manH - aH > maxDepth * atr

// ===== D - Distribution (CHoCH) =====
bool chochUp = live and sweptL and not deepL and not na(lastPH) and lastPHb >= aEndB and close > lastPH and close > aL and barstate.isconfirmed
bool chochDn = live and sweptH and not deepH and not na(lastPL) and lastPLb >= aEndB and close < lastPL and close < aH and barstate.isconfirmed

float slL = manL - slBuf * atr
float slS = manH + slBuf * atr
float tpL = tpMode == "Fixed R:R" ? close + rr * (close - slL) : aH
float tpS = tpMode == "Fixed R:R" ? close - rr * (slS - close) : aL
bool rrOkL = tpMode == "Fixed R:R" or (tpL - close) >= minRR * (close - slL)
bool rrOkS = tpMode == "Fixed R:R" or (close - tpS) >= minRR * (slS - close)

bool buySig  = chochUp and dxyOkBuy and rrOkL
bool sellSig = chochDn and dxyOkSell and rrOkS and not buySig

// CHoCH without DXY confirmation -> shown but not a signal
bool buyNoDxy  = chochUp and not dxyOkBuy
bool sellNoDxy = chochDn and not dxyOkSell

if buySig or sellSig
    done := true
    float e  = close
    float sl = buySig ? slL : slS
    float tp = buySig ? tpL : tpS
    status := (buySig ? "D: BUY " : "D: SELL ") + str.tostring(e, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick)
    label.new(bar_index, buySig ? manL : manH, "M", color = color.new(color.orange, 10), textcolor = color.white, style = buySig ? label.style_label_up : label.style_label_down, size = size.tiny)
    label.new(bar_index, buySig ? low : high, (buySig ? "BUY " : "SELL ") + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick) + (dxyMode != "Off" ? "\nDXY ✔" : ""), color = buySig ? color.new(#00C853, 0) : color.new(#D50000, 0), textcolor = color.white, style = buySig ? label.style_label_up : label.style_label_down, size = size.small)
    line.new(bar_index, e, bar_index + 20, e, color = color.gray)
    line.new(bar_index, sl, bar_index + 20, sl, color = #FF5252, width = 2)
    line.new(bar_index, tp, bar_index + 20, tp, color = #00E676, width = 2)
    alert("XAUUSD AMD " + (buySig ? "BUY " : "SELL ") + str.tostring(e, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | DXY confirmed", alert.freq_once_per_bar_close)

var int lastNoDxyBar = na
if (buyNoDxy or sellNoDxy) and (na(lastNoDxyBar) or bar_index - lastNoDxyBar > 10)
    lastNoDxyBar := bar_index
    label.new(bar_index, buyNoDxy ? low : high, "CHoCH\nDXY ✘", color = color.new(color.gray, 30), textcolor = color.white, style = buyNoDxy ? label.style_label_up : label.style_label_down, size = size.tiny)

if newSweepL or newSweepH
    alert("XAUUSD AMD: Asia " + (newSweepL ? "LOW" : "HIGH") + " swept (manipulation) - watch for " + (newSweepL ? "bullish" : "bearish") + " CHoCH", alert.freq_once_per_bar_close)

if accDone and not inTrade and inTrade[1] and not done
    status := "Window closed: no AMD setup today"

// ===== Visuals =====
bgcolor(showBg and inTrade and accDone and rangeOk and not done ? color.new(color.orange, 95) : na, title = "Signal window")
plot(live and not na(lastPH) and lastPHb >= aEndB and sweptL ? lastPH : na, "CHoCH level (buy)", color.new(#00E676, 30), 1, plot.style_linebr)
plot(live and not na(lastPL) and lastPLb >= aEndB and sweptH ? lastPL : na, "CHoCH level (sell)", color.new(#FF5252, 30), 1, plot.style_linebr)

// ===== Checklist table =====
var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(#131722, 10), border_width = 1)
if showTbl and barstate.islast
    bool tfOk = timeframe.isminutes and (timeframe.multiplier == 5 or timeframe.multiplier == 15)
    string dxyTxt = dxyMode == "Off" ? "off" : (dxyOkBuy ? "bearish -> favours BUY gold" : dxyOkSell ? "bullish -> favours SELL gold" : "neutral")
    color  dxyCol = dxyMode == "Off" ? color.gray : dxyOkBuy ? #00C853 : dxyOkSell ? #D50000 : color.gray
    tbl.cell(0, 0, "AMD + DXY", text_color = color.white, text_size = size.small)
    tbl.cell(1, 0, tfOk ? timeframe.period + "m ✔" : "Use M5 or M15", text_color = tfOk ? #00E676 : color.orange, text_size = size.small)
    tbl.cell(0, 1, "A  Asia range", text_color = color.white, text_size = size.small)
    tbl.cell(1, 1, accDone ? (rangeOk ? "✔ " : "✘ ") + str.tostring(aL, format.mintick) + " - " + str.tostring(aH, format.mintick) : inAcc ? "building..." : "-", text_color = accDone and rangeOk ? #00E676 : color.white, text_size = size.small)
    tbl.cell(0, 2, "M  Sweep", text_color = color.white, text_size = size.small)
    tbl.cell(1, 2, sweptL and sweptH ? "both sides" : sweptL ? "✔ LOW swept (bull)" : sweptH ? "✔ HIGH swept (bear)" : "-", text_color = sweptL or sweptH ? #FFB74D : color.white, text_size = size.small)
    tbl.cell(0, 3, "D  CHoCH", text_color = color.white, text_size = size.small)
    tbl.cell(1, 3, done ? "✔ signal" : (sweptL or sweptH) ? "waiting..." : "-", text_color = done ? #00E676 : color.white, text_size = size.small)
    tbl.cell(0, 4, "DXY", text_color = color.white, text_size = size.small)
    tbl.cell(1, 4, dxyTxt, text_color = color.white, bgcolor = color.new(dxyCol, 40), text_size = size.small)
    tbl.cell(0, 5, "Status", text_color = color.white, text_size = size.small)
    tbl.cell(1, 5, status, text_color = color.white, text_size = size.tiny)

alertcondition(buySig, "AMD BUY", "XAUUSD AMD BUY (DXY confirmed)")
alertcondition(sellSig, "AMD SELL", "XAUUSD AMD SELL (DXY confirmed)")
